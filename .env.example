# Set these in Render > LEXI > Environment. This file contains examples only.
# Local Python does not automatically load .env files.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT.neon.tech/neondb?sslmode=require
# Keep the existing SECRET_KEY. For a new service generate a random secret;
# never use a literal placeholder as the key.
# SECRET_KEY=
LEXI_PUBLIC_URL=https://lexi-m388.onrender.com
LEXI_COOKIE_SECURE=1
LEXI_TRUST_PROXY=1
LEXI_TIMEZONE=Asia/Bishkek
# Local development only; Render supplies PORT automatically.
# PORT=5000

# Add only after registering your own OAuth applications.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Only for the explicit copy tool; never needed by the running site.
# LEXI_SOURCE_DATABASE_URL=sqlite:////absolute/path/to/instance/lexi.sqlite3
