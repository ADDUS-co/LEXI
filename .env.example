# Optional. Flask does not read this file automatically.
# Set variables in your terminal or in Render's Environment settings.
LEXI_TIMEZONE=Asia/Bishkek
PORT=5000

# Local account storage defaults to instance/lexi.sqlite3.
# A private, persistent session key is created in instance/.session-key.
# Production: set DATABASE_URL to your managed PostgreSQL connection string
# and SECRET_KEY to a long random secret in the hosting Environment settings.
# Never commit these values or the instance/ directory.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE
# SECRET_KEY=replace-with-a-long-random-secret
# HTTPS deployment behind one trusted reverse proxy (Render):
# LEXI_COOKIE_SECURE=1
# LEXI_TRUST_PROXY=1

